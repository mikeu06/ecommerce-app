pipeline {

    agent any

    environment {
        AWS_REGION = 'us-east-1'
        TF_DIR = 'terraform/environments/dev'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Format Check') {
            steps {
                sh '''
                    set -e
                    terraform fmt -check -recursive terraform
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        cd "${TF_DIR}"

                        terraform init -input=false
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                sh '''
                    set -e

                    cd "${TF_DIR}"

                    terraform validate
                '''
            }
        }

        stage('Security Scan - Checkov') {
            steps {
                sh '''
                    set -e

                    checkov \
                        -d terraform \
                        --framework terraform
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    ),
                    usernamePassword(
                        credentialsId: 'terraform-db-credentials',
                        usernameVariable: 'TF_VAR_db_username',
                        passwordVariable: 'TF_VAR_db_password'
                    )
                ]) {
                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        cd "${TF_DIR}"

                        terraform plan \
                            -input=false \
                            -out=tfplan
                    '''
                }
            }
        }

        stage('Manual Approval') {
            steps {
                input(
                    message: 'Terraform validation, security scan and plan passed. Approve deployment?',
                    ok: 'Deploy'
                )
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    ),
                    usernamePassword(
                        credentialsId: 'terraform-db-credentials',
                        usernameVariable: 'TF_VAR_db_username',
                        passwordVariable: 'TF_VAR_db_password'
                    )
                ]) {
                    sh '''
                        set -e

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        cd "${TF_DIR}"

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            tfplan
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                rm -f "${TF_DIR}/tfplan"
            '''
        }
    }
}
