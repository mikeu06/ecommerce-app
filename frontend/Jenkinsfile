pipeline {

    agent any

    environment {
        AWS_REGION = 'us-east-1'

        S3_BUCKET = 'ecommerce-frontend-buckets'

        CLOUDFRONT_DISTRIBUTION_ID = 'E3BOCWTOPS1NNG'

        API_URL = 'https://devopsworkshop.online/api'
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Verify Repository') {
            steps {
                sh '''
                    echo "Workspace:"
                    pwd

                    echo ""
                    echo "Repository:"
                    ls -la

                    echo ""
                    echo "Frontend:"
                    ls -la frontend
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e
                        npm ci
                    '''
                }
            }
        }

        stage('Build React App') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e
                        npm run build
                    '''
                }
            }
        }

        stage('Check SonarScanner') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    sh """
                        ${scannerHome}/bin/sonar-scanner --version
                    """
                }
            }
        }

        stage('SonarQube Analysis Frontend') {
            steps {
                script {

                    def scannerHome = tool 'SonarScanner'

                    dir('frontend') {

                        withSonarQubeEnv('sonarqube') {

                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=ecommerce-frontend \
                                -Dsonar.projectName=ecommerce-frontend \
                                -Dsonar.sources=src
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Update Environment Config') {
            steps {
                dir('frontend') {

                    sh '''
                        set -e

                        echo "Updating frontend API configuration..."

                        if [ ! -f public/env-config.js ]; then
                            echo "ERROR: public/env-config.js not found"
                            exit 1
                        fi

                        sed -i 's|API_URL:.*|API_URL: "https://devopsworkshop.online/api"|g' \
                            public/env-config.js

                        echo ""
                        echo "Updated env-config.js:"
                        cat public/env-config.js
                    '''
                }
            }
        }

        stage('Final Build') {
            steps {
                dir('frontend') {

                    sh '''
                        set -e

                        echo "Creating final production build..."

                        rm -rf build

                        npm run build

                        echo ""
                        echo "Checking final environment configuration..."

                        cat build/env-config.js
                    '''
                }
            }
        }

        stage('Upload Build Files to S3') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    dir('frontend') {

                        sh '''
                            set -e

                            echo "Uploading frontend to S3..."

                            aws s3 sync build/ \
                                s3://${S3_BUCKET}/ \
                                --delete

                            echo "Frontend uploaded successfully."
                        '''
                    }
                }
            }
        }

        stage('CloudFront Invalidation') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "Creating CloudFront invalidation..."

                        aws cloudfront create-invalidation \
                            --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} \
                            --paths "/*"

                        echo "CloudFront invalidation created."
                    '''
                }
            }
        }
    }

    post {

        always {

            echo "Frontend pipeline completed with status: ${currentBuild.currentResult}"
        }

        success {

            echo "Frontend CI/CD pipeline completed successfully."
        }

        failure {

            echo "Frontend CI/CD pipeline failed."
        }
    }
}
