pipeline {
    agent any

    environment {
        S3_BUCKET = 'ecommerce-frontend-buckets'
        CLOUDFRONT_DISTRIBUTION_ID = 'E3BOCWTOPS1NNG'
        SONARQUBE_SERVER = 'sonarqube'
    }

    stages {

        stage('Clone Repository') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Build React App') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Check SonarScanner') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'
                    sh "${scannerHome}/bin/sonar-scanner --version"
                }
            }
        }

        stage('SonarQube Analysis Frontend') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    dir('frontend') {
                        withSonarQubeEnv("${SONARQUBE_SERVER}") {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=ecommerce-frontend \
                                -Dsonar.projectName=ecommerce-frontend \
                                -Dsonar.sources=src
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Update Environment Config') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "Updating frontend environment configuration..."

                        if [ -f public/env-config.js ]; then
                            sed -i "s|API_URL:.*|API_URL: \\"https://devopsworkshop.online/api\\"|g" public/env-config.js
                        fi
                    '''
                }
            }
        }

        stage('Final Build') {
            steps {
                dir('frontend') {
                    sh '''
                        rm -rf build
                        npm run build
                    '''
                }
            }
        }

        stage('Upload Build Files to S3') {
            steps {
                dir('frontend') {
                    sh '''
                        aws s3 sync build/ s3://${S3_BUCKET}/ --delete
                    '''
                }
            }
        }

        stage('CloudFront Invalidation') {
            steps {
                sh '''
                    aws cloudfront create-invalidation \
                    --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} \
                    --paths "/*"
                '''
            }
        }
    }

    post {
        success {
            echo 'Frontend CI/CD pipeline completed successfully.'
            echo 'Frontend deployed to S3 and CloudFront cache invalidated.'
        }

        failure {
            echo 'Frontend CI/CD pipeline failed.'
        }

        always {
            echo "Pipeline finished with status: ${currentBuild.currentResult}"
        }
    }
}
